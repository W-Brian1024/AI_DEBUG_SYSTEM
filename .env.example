# ESP32 AI Debug System Environment Variables
# ==========================================
# Copy this file to .env and customize the values

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AI Service Configuration
# ZhiPu AI (recommended for Chinese log analysis)
ZHIPU_API_KEY=your-zhipu-api-key-here

# Alternative AI Services (commented out)
# OPENAI_API_KEY=your-openai-api-key-here
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Redis Configuration (optional, defaults to config.yaml values)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Server Configuration (optional)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# SERVER_DEBUG=false

# ESP32 Configuration (optional)
# ESP32_DEFAULT_BAUD_RATE=115200
# ESP32_TIMEOUT_NO_LOG=20
# ESP32_LOG_DIRECTORY=./logs

# Development Mode (optional)
# DEVELOPMENT_TEST_MODE=false
# DEVELOPMENT_MOCK_AI_RESPONSES=false